{
  "name": "open-flun",
  "version": "3.0.22",
  "description": "Flun 生态统一入口：一键安装、版本检查、项目初始化;覆盖 @flun/env、@flun/mailer、@flun/windows、@flun/webauthn-server、@flun/webauthn-browser、@flun/html-template 等官方包;",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js"
  },
  "main": "index.js",
  "bin": {
    "open-flun": "cli.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "open",
    "flun-ecosystem",
    "flun-installer",
    "webauthn",
    "auto ssl",
    "env",
    "mailer",
    "windows service",
    "html template",
    "placeholder"
  ],
  "files": [
    "cli.js",
    "open.js",
    "index.d.ts",
    "index.js",
    "copy-files.js",
    "example.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "flun <open@flun.top>",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/OpenFlun.git"
  },
  "homepage": "https://www.npmjs.com/package/open-flun#readme",
  "bugs": {
    "url": "https://github.com/OpenFlun/OpenFlun/issues"
  },
  "allowScripts": {
    "@flun/desktop-builder": true,
    "@flun/dns-auto-ssl": true,
    "@flun/env": true,
    "@flun/html-template": true,
    "@flun/mailer": true,
    "@flun/windows": true,
    "@flun/webauthn-browser": true,
    "@flun/webauthn-server": true
  }
}
